{
  "name": "dog-motion-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run build && node server.mjs",
    "build": "node scripts/validate-web-assets.mjs && node scripts/build-web.mjs",
    "preview": "node server.mjs",
    "start": "node server.mjs",
    "test": "node --test scripts/*.test.mjs",
    "models:prepare": "node scripts/prepare-web-models.mjs"
  },
  "dependencies": {
    "meshoptimizer": "1.3.0",
    "three": "0.183.2"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "sharp": "0.35.5"
  }
}
